{
  "name": "mindfuels-backend",
  "version": "1.0.0",
  "description": "REST API backend for Mindfuels E-Commerce",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test-db": "node scratch/test_db.js",
    "postinstall": "cd ../frontend && npm install && npm run build && mkdir -p ../backend/public && cp -r dist/. ../backend/public/"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "express-rate-limit": "^7.3.1",
    "googleapis": "^140.0.0",
    "mysql2": "^3.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.4",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
