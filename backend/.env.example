# Server Configuration
PORT=5000
FRONTEND_URL=https://mindfuels-frontend.onrender.com

# Database Connection (MySQL on Hostinger)
DB_HOST=your-hostinger-mysql-hostname
DB_PORT=3306
DB_USER=your-database-username
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# Auth0 Configuration
AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com/
AUTH0_AUDIENCE=https://api.mindfuels.com
AUTH0_CLIENT_ID=your-auth0-client-id

# Razorpay Payments API
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Fship Shipping Aggregator
# Use https://capi-qc.fship.in for staging / sandbox testing, and https://capi.fship.in for production
FSHIP_BASE_URL=https://capi-qc.fship.in
FSHIP_API_KEY=your-fship-signature-token

# Google Sheets Configuration (for Product Sync)
# The private key must replace newlines correctly (e.g. replacing \n with actual newlines in code)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID=your-google-sheet-id-from-url
