# Mindfuels Frontend Environment Variables

# Backend API base URL (no trailing slash)
# Local development: http://localhost:5000
# Production: https://mindfuels-backend.onrender.com
VITE_API_BASE_URL=https://mindfuels-backend.onrender.com

# Auth0 Configuration (Single Page Application credentials)
VITE_AUTH0_DOMAIN=your-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.mindfuels.com

# Feature Flags — set to 'false' to hide a section without redeploying
VITE_SHOW_TEACHERS_RECOMMENDATION=true
VITE_SHOW_PARENTS_FIRST_CHOICE=true
